# The broker the workshop uses. Copy this file to broker.env and edit it. Without broker.env, the services and
# cluster/cluster.sh use the local Docker cluster. A RABBITMQ_URL environment variable overrides this file.

# Local cluster (the default): one URL per node, separated by commas. %2F is the virtual host "/".
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F,amqp://guest:guest@localhost:5673/%2F,amqp://guest:guest@localhost:5674/%2F

# CloudAMQP: paste the AMQP URL from your instance's details page instead. The part after the last / is the
# virtual host.
# RABBITMQ_URL=amqps://USER:PASSWORD@HOST.rmq.cloudamqp.com/VHOST

# Optional: the management HTTP API, used by cluster/cluster.sh. By default it's http://HOST:15672 for amqp:// URLs
# (one per node) and https://HOST for amqps:// URLs.
# RABBITMQ_MGMT_URL=https://HOST.rmq.cloudamqp.com
